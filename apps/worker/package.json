{
  "name": "@vancod/worker",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
    "dev": "tsup src/index.ts --format cjs --watch --onSuccess \"node dist/index.js\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@vancod/affiliate-core": "workspace:*",
    "@vancod/ai": "workspace:*",
    "@vancod/config": "workspace:*",
    "@vancod/connector-shopee": "workspace:*",
    "@vancod/connector-aliexpress": "workspace:*",
    "@vancod/connector-amazon": "workspace:*",
    "@vancod/connector-mercadolivre": "workspace:*",
    "@vancod/connector-magalu": "workspace:*",
    "@vancod/database": "workspace:*",
    "@vancod/logger": "workspace:*",
    "@vancod/telegram-bot": "workspace:*",
    "@vancod/types": "workspace:*",
    "bullmq": "^5.41.3",
    "ioredis": "^5.5.0"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
