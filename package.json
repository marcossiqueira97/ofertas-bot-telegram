{
  "name": "vancod-ofertas-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 20",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @vancod/database db:generate",
    "db:push": "pnpm --filter @vancod/database db:push",
    "db:seed": "pnpm --filter @vancod/database db:seed",
    "ingest:real": "pnpm --filter @vancod/database exec tsx ../../scripts/ingest-real-offer.ts"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.21.0"
}
